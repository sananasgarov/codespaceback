# Copy to .env and fill in real values. Never commit the real .env file.

# Server
PORT=8080

# CORS - frontend origin(s), comma separated
CORS_ORIGIN=http://localhost:3000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
DB_LOGGING=false

# WebSocket (STOMP over SockJS)
WS_PATH=/ws-devroom

# Code execution sandbox (requires Docker installed and running on this host)
EXEC_TIMEOUT_SECONDS=10
EXEC_MEMORY_LIMIT_MB=128
EXEC_MAX_CONCURRENT_CONTAINERS=5
EXEC_QUEUE_WAIT_SECONDS=30

# Teacher auth (JWT) - generate a long random value, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Free trial length (days) for new teacher accounts
TRIAL_DAYS=7

# Internal/demo billing - no real payment gateway is wired up yet.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=
BILLING_CURRENCY=AZN
BILLING_PRICE_MINOR=999
BILLING_PERIOD_DAYS=30
