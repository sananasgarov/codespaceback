# Server
PORT=8080

# CORS - frontend origin(s), comma separated
CORS_ORIGIN=http://localhost:3000

# Database (MongoDB Atlas)
# Paste the full connection string from Atlas -> Connect -> Drivers.
# Include the database name before the "?" query string, e.g.:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devroom?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devroom?retryWrites=true&w=majority
DB_LOGGING=true

# WebSocket (STOMP over SockJS)
WS_PATH=/ws-devroom

# Code execution (POST /api/v1/executions/run calls the free public Wandbox
# API - see src/services/codeRunner.service.js - no local sandbox to configure)
EXEC_TIMEOUT_SECONDS=10
EXEC_MEMORY_LIMIT_MB=128
EXEC_MAX_CONCURRENT_CONTAINERS=5
EXEC_QUEUE_WAIT_SECONDS=30
